<?xml version="1.0" encoding="utf-8"?>
<!-- Compact multimedia widget card (260dp wide, horizontal layout). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_card"
        android:padding="12dp">

        <!-- Left: spinning disc + outer progress ring -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_vertical">

            <com.example.plugin.media.RingProgressView
                android:id="@+id/widget_ring_progress"
                android:layout_width="76dp"
                android:layout_height="76dp" />

            <View
                android:id="@+id/widget_disc"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_disc" />
        </FrameLayout>

        <!-- Right: media info column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- Header: title + clock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="♪ MEDIA"
                    android:textColor="@color/widget_title_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/widget_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_time_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Song title + artist -->
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="夜空中最亮的星 · 逃跑计划"
                android:textColor="@color/widget_title_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Lyrics line -->
            <TextView
                android:id="@+id/widget_lyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="start"
                android:text="夜空中最亮的星"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:fontFamily="serif"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Control row: buttons + times -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="◀"
                    android:textColor="@color/widget_btn_text"
                    android:textSize="11sp"
                    android:background="@drawable/widget_btn" />

                <TextView
                    android:id="@+id/widget_btn_play"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/widget_btn_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_btn" />

                <TextView
                    android:id="@+id/widget_btn_next"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/widget_btn_text"
                    android:textSize="11sp"
                    android:background="@drawable/widget_btn" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_time_cur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="0:00"
                    android:textColor="@color/widget_value_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4:00"
                    android:textColor="@color/widget_value_text"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
