<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.plugin.media"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="33"
        android:targetSdkVersion="33" />

    <!-- A plugin APK must hold the same signature as the host, so this permission is granted. -->
    <uses-permission android:name="com.android.systemui.permission.PLUGIN" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="Media Widget Plugin"
        android:supportsRtl="true"
        android:testOnly="true" >

        <!--
            宿主通过查询匹配插件 action 的 Service 来发现插件。
            该 Service 永远不会被真正绑定/启动，仅作为 PackageManager 的注册表使用。
            service 的类名必须指向插件实现类，因为宿主会通过 Class.forName() 直接实例化它。
        -->
        <service
            android:name="com.example.plugin.media.MediaWidgetViewPlugin"
            android:exported="false" >
            <intent-filter>
                <action android:name="com.android.systemui.action.PLUGIN_WIDGET_VIEW" />
            </intent-filter>
        </service>
    </application>

</manifest>