<?xml version="1.0" encoding="utf-8"?>
<!-- Spinning disc: radial gradient album art placeholder. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:startColor="@color/widget_accent"
        android:endColor="@color/widget_accent_dark"
        android:gradientRadius="56dp"
        android:centerX="0.5"
        android:centerY="0.5" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_card_stroke" />
</shape>
