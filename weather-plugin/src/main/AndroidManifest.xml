<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 插件 APK 必须与宿主同签名，因此该权限会被授予 -->
    <uses-permission android:name="com.android.systemui.permission.PLUGIN" />

    <application
        android:allowBackup="false"
        android:label="Weather Widget Plugin"
        android:supportsRtl="true">

        <!--
            宿主通过查询匹配插件 action 的 Service 来发现插件。
            该 Service 永远不会被真正绑定/启动，仅作为 PackageManager 的注册表使用。
            service 的类名必须指向插件实现类，因为宿主会通过 Class.forName() 直接实例化它。
        -->
        <service
            android:name=".WeatherWidgetViewPlugin"
            android:exported="false">
            <intent-filter>
                <action android:name="com.android.systemui.action.PLUGIN_WIDGET_VIEW_WEATHER" />
            </intent-filter>
        </service>

    </application>

</manifest>
